{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-project:project-control:template-roadmap:v1",
  "title": "Template Roadmap v1",
  "description": "The skeleton's own roadmap (provenance/roadmap-template.v1.json): its maintenance chantiers, decisions, next steps and the Project Owner's ideas about the template. Describes the template, never a derived project; a derived project carries it as ancestry only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "template",
    "versions",
    "next_version",
    "chantiers",
    "now",
    "waiting_for_owner",
    "next_steps",
    "later",
    "ideas",
    "past"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "backups",
        "current_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "backups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "The version this roadmap file was written for (listed in versions). The view derives the last promoted version from the repository's tags; a listed version without a tag is shown as the next one."
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "label",
          "decisions"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TPL-D-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "next_version": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "label"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The next version when no listed version is pending a tag; null shows the default placeholder."
    },
    "chantiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "state",
          "summary",
          "versions",
          "decisions",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{1,3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "DONE",
              "PARTIAL",
              "IN_PROGRESS",
              "SCOPED",
              "TO_SCOPE",
              "LATER"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TPL-D-[0-9]{3,}$"
            }
          },
          "scope": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "now": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "tone",
          "source"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "type": "string",
            "enum": [
              "good",
              "warn",
              "neutral"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "waiting_for_owner": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "source"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "source"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "later": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "source"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idea_id",
          "stated_at",
          "quote",
          "source",
          "state",
          "target",
          "note"
        ],
        "properties": {
          "idea_id": {
            "type": "string",
            "pattern": "^ID-[0-9]{3,}$"
          },
          "stated_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "EVOKED",
              "TO_CLARIFY",
              "TO_SET",
              "SCOPED",
              "PLANNED",
              "IN_PROGRESS",
              "REALIZED",
              "APPLIED",
              "INTEGRATED",
              "LATER",
              "DISCARDED"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "past": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "title",
          "version",
          "details",
          "sources"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "string"
          }
        }
      }
    }
  }
}
