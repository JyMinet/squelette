{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-project:project-control:conversation-reference:v1",
  "title": "Conversation Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "conversation_ref", "provider", "workspace", "title", "date", "purpose", "related_work_items", "external_reference", "summary_reference"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "conversation_ref": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "workspace": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^(UNKNOWN|[0-9]{4}-[0-9]{2}-[0-9]{2})$"},
    "purpose": {"type": "string", "minLength": 1},
    "related_work_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^WI-[0-9]{3,}$"}},
    "external_reference": {"type": ["string", "null"]},
    "summary_reference": {"type": "string", "minLength": 1}
  }
}
